default_platform(:android)

platform :android do
  desc "Runs all checks: ktlint, license headers, lint, tests, architecture rules"
  lane :test do
    gradle(task: "check")
    # applyLicenseHeader runs as part of check; any file it had to touch fails CI here.
    sh("git diff --exit-code")
  end

  desc "Submit a new Beta Build to Play Store Internal Track"
  lane :beta do
    gradle(task: "clean assembleRelease")
    upload_to_play_store(track: 'internal', apk: 'app/build/outputs/apk/release/app-release.apk')
  end

  desc "Deploy a new version to the Google Play Store"
  lane :deploy do
    gradle(task: "clean bundleRelease")
    upload_to_play_store(track: 'production')
  end
end
